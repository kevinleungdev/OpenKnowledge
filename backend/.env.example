####################################
# RUNTIME ENVIRONMENT
####################################

# 'dev' = local demo mode: SQLite DB, sqlite-vec vectors, local-disk storage,
# and a fake admin user (Supabase auth disabled). Anything other than 'dev'
# restores JWT auth + Postgres/pgvector.
ENV=dev


####################################
# DATABASE CONFIGURATION
####################################

# --- Local demo mode (SQLite) ---
# Leave DATABASE_URL unset to use the default `sqlite:///{DATA_DIR}/knowledgebase.db`
# computed in env.py. DATABASE_SCHEMA must be unset (None) on SQLite, and the
# pool settings below are ignored (NullPool is used).

# --- Production (Supabase / Postgres) — commented out, kept for switch-back ---
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-east-2.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=public
# DATABASE_POOL_SIZE=5
# DATABASE_POOL_MAX_OVERFLOW=2
# DATABASE_POOL_RECYCLE=3600
# DATABASE_POOL_TIMEOUT=60


####################################
# VECTOR DATABASE
####################################

# Local demo: sqlite-vec vector store (cosine, stored in the same SQLite file).
VECTOR_DB=sqlite_vec

# Production: pgvector (requires a Postgres DATABASE_URL above).
# VECTOR_DB=pgvector

PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=1536


####################################
# STORAGE PROVIDER CONFIGURATION
####################################

# Local demo: save uploaded files to disk under data/uploads.
STORAGE_PROVIDER=local

# Production (Supabase / S3) — commented out, kept for switch-back:
# STORAGE_PROVIDER=s3
# S3_ACCESS_KEY_ID=your-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_REGION_NAME=us-east-2
# S3_BUCKET_NAME=knowledge_base
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_KEY_PREFIX=oss


####################################
# FILE UPLODD CONFIGURATION
####################################

ALLOWED_FILE_EXTENSIONS=md


####################################
# RAG CONFIGURATION
####################################

# Default: AliCloud DashScope via the official `dashscope` SDK.
RAG_EMBEDDING_ENGINE=dashscope
RAG_EMBEDDING_MODEL=text-embedding-v4

RAG_RERANKING_ENGINE=dashscope
RAG_RERANKING_MODEL=qwen3-rerank

# DashScope API key. (The SDK also reads DASHSCOPE_API_KEY from the env if this
# is unset.)
RAG_DASHSCOPE_API_KEY=your-dashscope-api-key

# Texts per embedding request; the generator chunks input and concatenates.
# RAG_DASHSCOPE_EMBEDDING_BATCH_SIZE=25

# Jina is still supported - set the engines above to `jina` to use it instead:
# RAG_EMBEDDING_ENGINE=jina
# RAG_EMBEDDING_MODEL=jina-embeddings-v3
# RAG_RERANKING_ENGINE=jina
# RAG_RERANKING_MODEL=jina-reranker-v2-base-multilingual
# RAG_JINA_API_BASE_URL=https://api.jina.ai/v1/
# RAG_JINA_API_KEY=your-jina-api-key


####################################
# LANGCHAIN CONFIGURATION
####################################

# Use `LangSmith` to trace requests, debug agent behavior, and evaluate outputs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=open-knowledge


####################################
# LANGCHAIN CONFIGURATION
####################################

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.deepseek.com

TAVILY_API_KEY=your-tavily-api-key

